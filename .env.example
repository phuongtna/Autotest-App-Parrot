# Copy file này thành .env rồi điền package name thật của app Parrot.
# Tìm package name bằng: ./scripts/find_appid.sh parrot
APP_ID=com.example.parrot

# CMS/backend nội dung bài học (dùng để lấy danh sách Book/Unit/Lesson/Exercise + đáp án đúng
# khi test random bài học - xem automation/README.md). Không commit giá trị thật - chỉ điền
# vào .env (đã gitignore).
CMS_BASE_URL=https://parrotedu.vn/api/cms
CMS_ACCESS_TOKEN=your_token_here
