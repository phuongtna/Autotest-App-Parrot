# Copy file này thành .env rồi điền package name thật của app Parrot.
# Tìm package name bằng: ./scripts/find_appid.sh parrot
APP_ID=com.example.parrot

# CMS/backend nội dung bài học (dùng để lấy danh sách Book/Unit/Lesson/Exercise + đáp án đúng
# khi test random bài học - xem automation/README.md). Không commit giá trị thật - chỉ điền
# vào .env (đã gitignore).
CMS_BASE_URL=https://parrotedu.vn/api/cms
CMS_ACCESS_TOKEN=your_token_here

# Tài khoản CMS admin - dùng bởi ./get_tokens.sh để tự lấy CMS_ACCESS_TOKEN/EXAM_COOKIE
# (thay cho copy tay qua DevTools).
CMS_USERNAME=your_cms_username
CMS_PASSWORD=your_cms_password

# Tài khoản giáo viên - dùng bởi ./get_teacher_token.sh để tự lấy TEACHER_ACCESS_TOKEN
# (xem automation/README.md mục "Bài tập").
TEACHER_USERNAME=your_teacher_username
TEACHER_PASSWORD=your_teacher_password

# Host của teacher-portal (web GV: /teacher/class, /teacher/assign...) - dùng bởi
# automation/giao_bai_tap/, automation/quan_ly_lop_hoc/ (Playwright). Chọn môi trường qua
# TEACHER_PORTAL_ENV: dev | staging | production - xem resolveTeacherPortalBaseUrl() trong
# automation/src/config.js (cùng cơ chế CMS_ADMIN_ENV bên dưới). KHÔNG dùng biến phẳng
# TEACHER_PORTAL_BASE_URL nữa - sự cố thật (2026-09-08): biến phẳng không có khái niệm môi trường
# nên `npm run add-class` chạy nhầm lên production dù ý định là staging.
TEACHER_PORTAL_ENV=staging
TEACHER_PORTAL_BASE_URL_DEV=
TEACHER_PORTAL_BASE_URL_STAGING=https://parrotedu-staging.parrotedu.vn
TEACHER_PORTAL_BASE_URL_PRODUCTION=https://parrotedu.vn

# CMS Quản lý (web admin: /packages, /orders, /students) - KHÁC CMS_BASE_URL ở trên (đó là API
# nội dung bài học/Exam). Dùng bởi automation/quan_ly_goi_dich_vu/ (Playwright). Đăng nhập dùng
# chung CMS_USERNAME/CMS_PASSWORD ở trên - đã xác nhận cùng 1 tài khoản admin cho cả 3 môi trường.
# Chọn môi trường chạy test: dev | staging | production
CMS_ADMIN_ENV=staging

# Chưa có môi trường dev riêng tại thời điểm viết file này - để trống. Nếu CMS_ADMIN_ENV=dev mà
# biến này trống, config.js sẽ báo lỗi rõ ràng thay vì âm thầm chạy nhầm môi trường khác.
CMS_ADMIN_URL_DEV=
CMS_ADMIN_URL_STAGING=https://cms-staging.parrotedu.vn
CMS_ADMIN_URL_PRODUCTION=https://cms.parrotedu.vn

# Số điện thoại 1 học sinh CÓ THẬT trên môi trường đang test (CMS_ADMIN_ENV ở trên) - dùng bởi
# automation/quan_ly_goi_dich_vu/ (nhóm case GRANT-*/DEACT-05). PHẢI đổi khi đổi môi trường - mỗi
# môi trường có dữ liệu học sinh khác nhau. Để trống thì nhóm case đó tự SKIP.
CMS_ADMIN_TEST_STUDENT_PHONE=
